# Supabase Environment Configuration Example
# Copy this file to '.env.local' in the same folder and fill in your actual credentials.

# Your Supabase Project API URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon Public API Key (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-public-key
