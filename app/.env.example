# Supabase Environment Configuration Example
# Copy this file to '.env.local' in the same folder and fill in your actual credentials.

# Your Supabase Project API URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon Public API Key (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ─── CLOUDFLARE R2 CONFIGURATIONS ───
# Find these in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_s3_client_access_key
R2_SECRET_ACCESS_KEY=your_r2_s3_client_secret_key
R2_BUCKET_NAME=hslm-moment-gallery

# The public URL of your bucket (Found in R2 -> select Bucket -> Settings -> Public Backends)
# It will look like https://pub-xxxxxx.r2.dev or your custom domain name
VITE_R2_PUBLIC_URL=https://your-public-r2-url.dev
