# Supabase Environment Configuration Example
# Copy this file to '.env.local' in the same folder and fill in your actual credentials.

# Your Supabase Project API URL (found in Project Settings -> API)
VITE_SUPABASE_URL=

# Your Supabase Anon Public API Key (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=

# ─── BACKBLAZE B2 S3 CLOUD STORAGE CONFIGURATIONS ───
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# The public URL of your Backblaze B2 bucket (format: https://f00X.backblazeb2.com/file/your-bucket-name)
VITE_S3_PUBLIC_URL=

# The primary production URL of your website (e.g., https://acelyamuhammet.vercel.app)
# This forces the QR Code link to always point to your production URL, preventing guests from landing on Vercel preview domains.
VITE_SITE_URL=
