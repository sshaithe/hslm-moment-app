# Supabase Environment Configuration Example
# Copy this file to '.env.local' in the same folder and fill in your actual credentials.

# Your Supabase Project API URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon Public API Key (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ─── TEBI.IO S3 CLOUD STORAGE CONFIGURATIONS ───
# Endpoint is https://s3.tebi.io by default for Tebi
S3_ENDPOINT=https://s3.tebi.io
S3_ACCESS_KEY_ID=your_tebi_access_key_id
S3_SECRET_ACCESS_KEY=your_tebi_secret_access_key
S3_BUCKET_NAME=hslm-moment-gallery

# The public URL of your Tebi bucket (format: https://s3.tebi.io/your-bucket-name)
VITE_S3_PUBLIC_URL=https://s3.tebi.io/hslm-moment-gallery
