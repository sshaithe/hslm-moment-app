# ─────────────────────────────────────────────────────────────────────────────
# VowVault Local Server — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Full connection string. Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://vowvault:your_secure_password@localhost:5432/vowvault
DATABASE_POOL_MAX=10

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# Comma-separated list of allowed CORS origins.
# Add your Vercel domain and Cloudflare Tunnel URL when going live.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:4000

# ─── Backblaze B2 ─────────────────────────────────────────────────────────────
# Get these from your Backblaze account: App Keys section.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# Public base URL for direct CDN access (no proxy through your PC).
# Format: https://f005.backblazeb2.com/file/your-bucket-name
# OR your Cloudflare CDN domain if configured.
B2_PUBLIC_BASE_URL=
